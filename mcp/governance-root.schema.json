{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/magicvr/goal-governance/schema/governance-root-config/v1",
  "title": "Goal Governance project configuration",
  "description": "Committable governance root and independent audit CLI defaults; installation preserves this project-owned file.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "independent_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoning_effort"],
      "properties": {
        "provider": {"enum": ["codex", "claude", "grok"]},
        "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
        "reasoning_effort": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"provider": {"const": "codex"}}}, "then": {"properties": {"reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh"]}}}},
        {"if": {"properties": {"provider": {"const": "claude"}}}, "then": {"properties": {"reasoning_effort": {"enum": ["low", "medium", "high", "max"]}}}},
        {"if": {"properties": {"provider": {"const": "grok"}}}, "then": {"properties": {"reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]}}}}
      ]
    },
    "governance_root": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative governance root (default: docs). Absolute paths and '..' escapes fail closed; internal layout (vision/, workspaces/workspace-*, goal-tree, five-piece shape) is not configurable.",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\\\][^\\\\]*$"
    }
  }
}
