# Copy this file to web/.env before a future server-side AI integration.
# Do not commit web/.env or put a real credential in this example.
# The current read-only Web application does not load this file or call an AI API.

# Set to true only after the AI integration, consent boundary, and failure behavior are implemented.
GOAL_GOVERNANCE_AI_ENABLED=false

# Provider and endpoint. Leave unset until I-002 selects a provider and API contract.
GOAL_GOVERNANCE_AI_PROVIDER=
GOAL_GOVERNANCE_AI_BASE_URL=

# Server-side secret only. Keep this empty in the example and never expose it to the browser.
GOAL_GOVERNANCE_AI_API_KEY=

# Model and optional request parameters. Their provider-specific semantics remain to be defined.
GOAL_GOVERNANCE_AI_MODEL=
GOAL_GOVERNANCE_AI_REQUEST_TIMEOUT_SECONDS=30
GOAL_GOVERNANCE_AI_TEMPERATURE=
GOAL_GOVERNANCE_AI_MAX_OUTPUT_TOKENS=
