# Copy this file to web/.env for local overrides. Do not commit web/.env.
# Real API secrets must never appear in source, Markdown, browser responses, or logs.

# --- Workspace binding (GOAL-012) ---
# Explicit product workspace root (preferred). Fail closed when unset and dogfood is off.
# Local synthetic product root (not dogfood): ..\data\product-workspace
# GOAL_GOVERNANCE_WORKSPACE_DIR=C:\path\to\your\workspace-001-example
# GOAL_GOVERNANCE_DATA_ROOT=C:\path\to\data-root

# Opt-in only: load this monorepo's process workspace for local dogfood.
# Never enable in release installs. Default is false / unset.
# Do not combine dogfood with production controlled write.
GOAL_GOVERNANCE_DEV_DOGFOOD=false

# --- Controlled write (GOAL-009 A-030) ---
# Planning latch: default false after α gate closure (F-007/F-008 closed; I-003/I-004/I-006 verified).
# Set true to re-block all production controlled writes.
GOAL_GOVERNANCE_PRODUCT_GATES_OPEN=false

# Second latch: production controlled write. Set true only for a product workspace root
# (not monorepo dogfood), single-process deploy, and residual scope R-F008-1～3.
GOAL_GOVERNANCE_ALLOW_CONTROLLED_WRITE=false

# Test-only write authorization for contract tests / local harness. Do not set in production.
GOAL_GOVERNANCE_TEST_WRITE_MODE=false

# --- AI API (reserved; not loaded by current app for calls) ---
GOAL_GOVERNANCE_AI_ENABLED=false
GOAL_GOVERNANCE_AI_PROVIDER=
GOAL_GOVERNANCE_AI_BASE_URL=
GOAL_GOVERNANCE_AI_API_KEY=
GOAL_GOVERNANCE_AI_MODEL=
GOAL_GOVERNANCE_AI_REQUEST_TIMEOUT_SECONDS=30
GOAL_GOVERNANCE_AI_TEMPERATURE=
GOAL_GOVERNANCE_AI_MAX_OUTPUT_TOKENS=
