{
  "contractSchemaId": "https://github.com/magicvr/goal-governance/schema/skills-consumer-contract/v1",
  "contractFormat": "goal-governance.skills-consumer-contract",
  "contractFormatVersion": "0.4.0",
  "canonical": {
    "owner": "docs/contracts",
    "manifestPath": "docs/contracts/skills-consumer-contract.json",
    "schemaPath": "docs/contracts/skills-consumer-contract.schema.json"
  },
  "evidenceBoundary": {
    "defaultProfile": "consumer",
    "consumerRequired": [
      "skills-consumer-contract.json",
      "skills-consumer-contract.schema.json"
    ],
    "producerOnly": [
      "skills-consumer-compatibility-matrix.json",
      "skills-consumer-compatibility-matrix.schema.json",
      "runtime-evidence.schema.json"
    ]
  },
  "protocol": {
    "version": "0.1.0",
    "versionPolicy": "semver-2.0.0",
    "publicContract": {
      "goalTemplateFiles": [
        "00-meta.md",
        "01-decision.md",
        "02-execution.md",
        "03-audit.md"
      ],
      "goalLedgerDirectories": [
        "01-decision",
        "02-execution",
        "03-audit"
      ],
      "requiredFrontmatter": [
        "status",
        "created",
        "updated",
        "parent",
        "version"
      ],
      "hostEntrypoints": [
        "govern",
        "audit",
        "vision",
        "vision-audit"
      ]
    }
  },
  "supportBaseline": {
    "firstSupportedProtocol": "0.1.0",
    "previousSupportedProtocol": null
  },
  "deliveryChannels": [
    {
      "channel": "files",
      "status": "first-class",
      "evidenceLevels": ["L1", "L2", "L3"],
      "entrypoints": ["vision", "vision-audit", "govern", "audit"],
      "runtime": "skills zip + install 脚本；File-classic（无 Docker / 无 MCP）可用",
      "notes": "生产仓自举权威；L1 证据直接驱动 File 资产，禁止 MCP mock 顶替"
    },
    {
      "channel": "mcp",
      "status": "first-class",
      "evidenceLevels": ["L1", "L2", "L3"],
      "entrypoints": ["vision", "vision-audit", "govern", "audit"],
      "runtime": "MCP stdio 进程（Python 3，零第三方运行时依赖；Docker 可选）",
      "notes": "四治理入口工具等价；不替代仓内实例真相；commit 不入工具集；L3 证据为宿主入口面（MCP 进程面由 L1/L2 确定性覆盖）"
    }
  ],
  "templateSet": {
    "version": "0.1.1",
    "implementsProtocol": {
      "minInclusive": "0.1.0",
      "maxExclusive": "0.2.0"
    },
    "canonicalPath": "docs/templates/goal-folder",
    "mirrorPath": "skills/core/docs/templates/goal-folder"
  },
  "adapterCompatibilityStatus": "declared",
  "adapters": [
    {
      "id": "claude-code-cli",
      "supportsProtocol": {
        "minInclusive": "0.1.0",
        "maxExclusive": "0.2.0"
      },
      "entrypoints": [
        "govern",
        "audit",
        "vision",
        "vision-audit"
      ],
      "supportCommitment": "committed",
      "verificationStatus": "verified"
    },
    {
      "id": "grok-build-cli",
      "supportsProtocol": {
        "minInclusive": "0.1.0",
        "maxExclusive": "0.2.0"
      },
      "entrypoints": [
        "govern",
        "audit",
        "vision",
        "vision-audit"
      ],
      "supportCommitment": "committed",
      "verificationStatus": "verified"
    },
    {
      "id": "github-copilot-cli",
      "supportsProtocol": {
        "minInclusive": "0.1.0",
        "maxExclusive": "0.2.0"
      },
      "entrypoints": [
        "govern",
        "audit",
        "vision",
        "vision-audit"
      ],
      "supportCommitment": "committed",
      "verificationStatus": "verified"
    }
  ]
}
